<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appareil Jetable</title>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 20px; background: #f4f4f9; margin: 0; }
        .camera-btn {
            background: #ff4757; color: white; padding: 15px 30px; font-size: 18px;
            border: none; border-radius: 50px; cursor: pointer; display: inline-block; transition: 0.3s;
        }
        #cameraInput { display: none; }
        #status { margin-top: 20px; font-size: 16px; font-weight: bold; color: #333; }
        .success { color: #2ed573 !important; }

        /* Le modal de confirmation */
        #confirmationOverlay {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 100;
            justify-content: center; align-items: center; flex-direction: column;
            color: white; padding: 20px; box-sizing: border-box;
        }
        #previewImage {
            max-width: 90%; max-height: 55vh;
            border: 3px solid white; border-radius: 10px;
            margin-bottom: 20px;
        }
        .action-btns { display: flex; flex-direction: column; gap: 15px; width: 80%; max-width: 300px; }
        .process-btn {
            background: #2ed573; color: white; padding: 15px 20px; font-size: 16px; font-weight: bold;
            border: none; border-radius: 30px; cursor: pointer; transition: 0.2s;
        }
        .cancel-btn { background: #ccc; color: black; padding: 12px 20px; border: none; border-radius: 30px; font-size: 14px; cursor: pointer; }
        .loading { background: #ffaa00; pointer-events: none; }
    </style>
</head>
<body>

    <h1>📸 L'Album de la Soirée</h1>
    <p>Prenez une photo pour l'ajouter à l'album !</p>

    <label for="cameraInput" class="camera-btn">
        Prendre une photo
    </label>
   
    <input type="file" accept="image/*" capture="environment" id="cameraInput">

    <div id="status">En attente d'une photo...</div>

    <!-- LE MODAL DE CONFIRMATION -->
    <div id="confirmationOverlay">
        <h2>Votre Photo :</h2>
        <img id="previewImage" src="" alt="Aperçu">
       
        <div class="action-btns">
            <button id="processBtn" class="process-btn">✅ Valider et Envoyer</button>
            <button id="cancelBtn" class="cancel-btn">❌ Recommencer</button>
        </div>
       
        <p style="font-size: 12px; margin-top: 15px; color: #ccc;">
            Sur iPhone : Choisissez "Enregistrer l'image" dans le menu qui va s'ouvrir.
        </p>
    </div>

    <script>
        // --- CONFIGURATION ---
        const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwKXFaYzZLDJMf-Uhxa8deJ4NULojg9OeOg63eo6bs3XwnWozAANIJ7xhOsV-LBJsAF/exec"; // Gardez bien vos guillemets

        const cameraInput = document.getElementById('cameraInput');
        const statusDiv = document.getElementById('status');
        const overlay = document.getElementById('confirmationOverlay');
        const previewImage = document.getElementById('previewImage');
        const processBtn = document.getElementById('processBtn');
        const cancelBtn = document.getElementById('cancelBtn');

        let originalFile;

        // Quand on prend la photo
        cameraInput.addEventListener('change', (event) => {
            originalFile = event.target.files[0];
            if (!originalFile) return;

            const readerPreview = new FileReader();
            readerPreview.readAsDataURL(originalFile);
            readerPreview.onload = (e) => {
                previewImage.src = e.target.result;
                overlay.style.display = 'flex';
            }
        });

        // La fonction qui gère l'envoi vers le Google Drive
        const sendToDrive = () => {
            processBtn.classList.add("loading");
            processBtn.innerText = "⏳ Envoi vers l'album Drive...";
           
            const readerSend = new FileReader();
            readerSend.readAsDataURL(originalFile);
            readerSend.onload = function(e) {
                const img = new Image();
                img.src = e.target.result;
                img.onload = function() {
                    const MAX_WIDTH = 1600; const MAX_HEIGHT = 1600;
                    let width = img.width; let height = img.height;
                   
                    if (width > height) {
                        if (width > MAX_WIDTH) { height = Math.round((height *= MAX_WIDTH / width)); width = MAX_WIDTH; }
                    } else {
                        if (height > MAX_HEIGHT) { width = Math.round((width *= MAX_HEIGHT / height)); height = MAX_HEIGHT; }
                    }
                   
                    const canvas = document.createElement('canvas');
                    canvas.width = width; canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    const compressedBase64 = canvas.toDataURL('image/jpeg', 0.75);

                    const payload = {
                        filename: "photo_" + Date.now() + ".jpg",
                        mimeType: "image/jpeg",
                        base64: compressedBase64
                    };

                    fetch(GOOGLE_SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) })
                    .then(response => response.json())
                    .then(data => {
                        if(data.status === "error") throw new Error(data.message);
                        resetUI();
                        statusDiv.innerText = "✅ Photo validée et ajoutée à l'album !";
                        statusDiv.classList.add("success");
                    })
                    .catch(error => {
                        processBtn.classList.remove("loading");
                        processBtn.innerText = "❌ Réessayer l'envoi";
                    });
                };
            };
        };

        // Quand l'utilisateur clique sur "Valider"
        processBtn.addEventListener('click', async () => {
            // Créer un vrai fichier compatible avec le système Apple/Android
            const file = new File([originalFile], "Souvenir.jpg", { type: originalFile.type });

            try {
                // Si le téléphone supporte le menu de partage natif (iPhone / Android récents)
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({
                        files: [file],
                        title: 'Photo Souvenir',
                    });
                    // Dès que l'invité a cliqué sur "Enregistrer" ou fermé le menu, on envoie au Drive
                    sendToDrive();
                } else {
                    // Système classique (Vieux téléphones ou PC)
                    const a = document.createElement("a");
                    a.href = previewImage.src;
                    a.download = "Souvenir_" + Date.now() + ".jpg";
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    sendToDrive();
                }
            } catch (error) {
                // Si l'invité annule le menu de partage de l'iPhone, on envoie quand même sur le Drive
                sendToDrive();
            }
        });

        cancelBtn.addEventListener('click', resetUI);

        function resetUI() {
            overlay.style.display = 'none';
            cameraInput.value = "";
            processBtn.classList.remove("loading");
            processBtn.innerText = "✅ Valider et Envoyer";
            statusDiv.classList.remove("success");
            statusDiv.innerText = "En attente d'une photo...";
        }
    </script>
</body>
</html>
